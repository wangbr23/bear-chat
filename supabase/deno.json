{
  "compilerOptions": {
    "strict": true
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false,
    "include": ["functions", "tests/functions"]
  },
  "lint": {
    "include": ["functions", "tests/functions"],
    "rules": {
      "tags": ["recommended"]
    }
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno test tests/functions",
    "test": "deno test tests/functions"
  }
}
